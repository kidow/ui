{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "floating-navbar",
  "title": "Floating Navbar",
  "description": "스크롤에 따라 떠오르는 내비게이션 바(floating navbar, sticky nav).",
  "dependencies": [
    "lucide-react"
  ],
