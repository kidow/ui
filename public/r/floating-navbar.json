  "files": [
    {
      "path": "registry/kidow/floating-navbar.tsx",
      "content": "\"use client\";\n\n/**\n * Copyright (c) Spectrum UI — https://ui.spectrumhq.in\n * Licensed under the Apache License, Version 2.0.\n * https://www.apache.org/licenses/LICENSE-2.0\n *\n * 변경: import 경로를 이 레지스트리에 맞게 고쳤고, framer-motion 을\n * motion/react 로 통일했다. 그 밖의 내용은 원본과 같다.\n */\n\nimport * as React from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\";\nimport { Home, Menu, MessageSquare, Plus, Settings, Users } from \"lucide-react\";\n\nexport default function Floatingnavbar() {\n  return (\n    // add fixed  to the nav class name to make the navbar stick to the bottom of the screen\n    <div className=\" bottom-6 left-0 right-0 flex justify-center\">\n      <nav className=\"flex items-center justify-center space-x-4 rounded-full border bg-background p-2 shadow-lg\">\n        <Button variant=\"ghost\" size=\"icon\" className=\"rounded-full\">\n          <Home className=\"h-5 w-5\" />\n          <span className=\"sr-only\">Home</span>\n        </Button>\n        <Button variant=\"ghost\" size=\"icon\" className=\"rounded-full\">\n          <Users className=\"h-5 w-5\" />\n          <span className=\"sr-only\">Users</span>\n        </Button>\n        <DropdownMenu>\n          <DropdownMenuTrigger asChild>\n            <Button\n              size=\"icon\"\n              className=\"rounded-full bg-primary text-primary-foreground\"\n            >\n              <Plus className=\"h-5 w-5\" />\n              <span className=\"sr-only\">Add</span>\n            </Button>\n          </DropdownMenuTrigger>\n          <DropdownMenuContent align=\"center\">\n            <DropdownMenuItem>\n              <Users className=\"mr-2 h-4 w-4\" />\n              New Team\n            </DropdownMenuItem>\n            <DropdownMenuItem>\n              <MessageSquare className=\"mr-2 h-4 w-4\" />\n              New Chat\n            </DropdownMenuItem>\n            <DropdownMenuItem>\n              <Settings className=\"mr-2 h-4 w-4\" />\n              Settings\n            </DropdownMenuItem>\n          </DropdownMenuContent>\n        </DropdownMenu>\n        <Button variant=\"ghost\" size=\"icon\" className=\"rounded-full\">\n          <MessageSquare className=\"h-5 w-5\" />\n          <span className=\"sr-only\">Messages</span>\n        </Button>\n        <Button variant=\"ghost\" size=\"icon\" className=\"rounded-full\">\n          <Menu className=\"h-5 w-5\" />\n          <span className=\"sr-only\">Menu</span>\n        </Button>\n      </nav>\n    </div>\n  );\n}\n",
      "type": "registry:component",
      "target": "components/kidow/floating-navbar.tsx"
    }
  ],
  "meta": {
