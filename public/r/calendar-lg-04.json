{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "calendar-lg-04",
  "title": "Calendar Lg 04",
  "description": "날짜를 보여주는 큰 캘린더 위젯(calendar widget, 달력, 일정). 이번 달 날짜와 예정된 일정을 대시보드나 홈 화면 카드로 띄울 때 쓴다.",
  "registryDependencies": [
    "@kidow/widget",
