{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "kidow",
  "homepage": "https://ui.dongwook.kim",
  "items": [
    {
      "name": "marquee",
      "type": "registry:component",
      "title": "Marquee",
      "description": "콘텐츠를 끊김 없이 흘려보내는 가로/세로 마퀴(marquee, ticker). 로고 월(logo wall), 고객 후기·리뷰(testimonial) 슬라이더, 파트너사 나열처럼 목록을 자동 스크롤(infinite scroll)로 무한 반복 노출할 때 쓴다. hover 시 정지, 역방향, 반복 횟수 조절 지원.",
      "categories": ["애니메이션"],
      "files": [
        {
          "path": "registry/ui/marquee/marquee.tsx",
          "type": "registry:component",
          "target": "components/kidow/marquee.tsx"
        }
      ],
      "cssVars": {
        "theme": {
          "animate-marquee": "marquee var(--duration) infinite linear",
          "animate-marquee-vertical": "marquee-vertical var(--duration) linear infinite"
        }
      },
      "css": {
        "@keyframes marquee": {
          "from": {
            "transform": "translateX(0)"
          },
          "to": {
            "transform": "translateX(calc(-100% - var(--gap)))"
          }
        },
        "@keyframes marquee-vertical": {
          "from": {
            "transform": "translateY(0)"
          },
          "to": {
            "transform": "translateY(calc(-100% - var(--gap)))"
          }
        }
      },
      "meta": {
        "source": "MagicUI",
        "sourceUrl": "https://magicui.design/docs/components/marquee",
        "author": "magicuidesign",
        "license": "MIT",
        "retrievedAt": "2026-08-29"
      }
    },
    {
      "name": "terminal",
      "type": "registry:component",
      "title": "Terminal",
      "description": "CLI 실행 과정을 재현하는 터미널(terminal, console) 목업. 타이핑 애니메이션(typing animation)으로 설치 명령과 빌드 로그를 순차 재생해, 랜딩 히어로나 문서에서 제품 사용법을 시연할 때 쓴다. macOS 신호등 헤더, AnimatedSpan·TypingAnimation 조합, 화면에 들어올 때 시작.",
      "categories": ["코드·터미널"],
      "dependencies": ["motion"],
      "files": [
        {
          "path": "registry/ui/terminal/terminal.tsx",
          "type": "registry:component",
          "target": "components/kidow/terminal.tsx"
        }
      ],
      "meta": {
        "source": "MagicUI",
        "sourceUrl": "https://magicui.design/docs/components/terminal",
        "author": "magicuidesign",
        "license": "MIT",
        "retrievedAt": "2026-08-29"
      }
    }
  ]
}
